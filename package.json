{
  "name": "sanity-plugin-webhooks-trigger",
  "version": "0.5.0",
  "description": "",
  "keywords": [
    "sanity",
    "sanity-plugin"
  ],
  "homepage": "https://github.com/flayks/sanity-plugin-webhooks-trigger#readme",
  "bugs": {
    "url": "https://github.com/flayks/sanity-plugin-webhooks-trigger/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/flayks/sanity-plugin-webhooks-trigger.git"
  },
  "license": "MIT",
  "author": "Félix Péault (Flayks) <hello@flayks.com>",
  "sideEffects": false,
  "type": "commonjs",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "sanity.json",
    "src",
    "v2-incompatible.js"
  ],
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "format": "prettier --write --cache --ignore-unknown .",
    "link-watch": "plugin-kit link-watch",
    "lint": "eslint .",
    "prepublishOnly": "npm run build",
    "watch": "pkg-utils watch --strict"
  },
  "dependencies": {
    "@sanity/icons": "^3.7.4",
    "@sanity/incompatible-plugin": "^1.0.5",
    "@sanity/ui": "^3.0.7",
    "@types/react-dom": "^19.1.7",
    "crypto-js": "^4.2.0",
    "nanoid": "^5.1.5"
  },
  "devDependencies": {
    "@sanity/pkg-utils": "^7.11.9",
    "@sanity/plugin-kit": "^4.0.19",
    "@types/crypto-js": "^4.2.2",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@types/react": "^19.1.10",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "eslint-config-sanity": "^7.1.4",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.6.2",
    "prettier-plugin-packagejson": "^2.5.19",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sanity": "^4.4.1",
    "styled-components": "^6.1.19",
    "typescript": "^5.9"
  },
  "peerDependencies": {
    "react": "^19",
    "sanity": "^3 || ^4"
  },
  "engines": {
    "node": ">=18"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "sanityPlugin": {
    "verifyPackage": {
      "eslintImports": false
    }
  }
}
